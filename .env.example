# Copie para .env e preencha. O .env NAO e versionado.

# --- Modelos ---
# Pelo menos uma chave e necessaria para `harness-eng run`.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo padrao do harness minimo.
HARNESS_MODEL=claude-opus-5

# Teto de tokens por resposta. Streaming e ligado automaticamente acima de 16000.
HARNESS_MAX_TOKENS=16000

# Esforco: low | medium | high | xhigh | max
HARNESS_EFFORT=high

# --- Loop ---
# Teto de iteracoes. Existe para o loop nao rodar indefinidamente quando o modelo
# nunca emite end_turn — que e um modo de falha real, nao hipotetico.
HARNESS_MAX_ITERATIONS=50

# --- Analise ---
# Onde procurar transcripts. Vazio usa ~/.claude/projects
HARNESS_TRACE_ROOT=

# Substitui caminho e nome de projeto por hash estavel nos relatorios.
HARNESS_REDACT=false
